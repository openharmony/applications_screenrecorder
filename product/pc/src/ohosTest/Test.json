{
  "description": "Configuration for ScreenRecorder Tests",
  "driver": {
    "type": "OHJSUnitTest",
    "test-timeout": "180000",
    "bundle-name": "com.ohos.screenrecorder",
    "module-name": "pc_test",
    "shell-timeout": "600000",
    "testcase-timeout": "30000",
    "compile-mode": "esmodule",
    "coverage": true,
    "package-tool-path": "D:\\Local\\coverage2.0\\node_modules\\@ohos\\coverage"
  },
  "kits": [
    {
      "pre-push": "mount -o rw,remount /",
      "push": "ScreenRecorder.hap->/system/app/ScreenRecorder/ScreenRecorder.hap",
      "type": "PushKit",
      "post-push": [
        "bm install -p /system/app/ScreenRecorder/ScreenRecorder.hap",
        "power-shell wakeup",
        "uinput -T -m 540 1752 540 751 500",
        "power-shell timeout -o 1800000",
        "power-shell setmode 602",
        "uinput -T -c 630 1700"
      ]
    },
    {
      "test-file-name": [
        "ScreenRecorderTest.hap"
      ],
      "type": "AppInstallKit",
      "cleanup-apps": true
    },
    {
      "teardown-command": [
        "mount -o rw,remount /",
        "power-shell setmode 600"
      ],
      "type": "ShellKit"
    }
  ]
}
